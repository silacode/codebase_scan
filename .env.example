# Copy to .env and fill in optional credentials there; never add secrets to this example.
# Local backend: node --env-file=.env --watch src/index.ts
# npm run dev/start do not automatically load .env.
# Compose reads .env for variables referenced in docker-compose.yml.
# Compose overrides DATABASE_URL and does not forward PORT, ROLE or MAX_QUEUED.

# PostgreSQL connection (local development credentials only)
DATABASE_URL=postgres://scan:scan@localhost:5433/scan
# API listen port
PORT=8080
# api, worker, or all
ROLE=all
# Concurrent jobs per worker
WORKER_SLOTS=4
# Queue capacity
MAX_QUEUED=32
# Optional GitHub token (without it: 60 REST calls/hour)
GITHUB_TOKEN=
# Optional OpenAI explanations
OPENAI_API_KEY=
# OpenAI model
OPENAI_MODEL=gpt-5-mini
# Optional Jev classifications
TYPESAFE_API_KEY=
# Jev model
TYPESAFE_MODEL=jev-1.13.0
