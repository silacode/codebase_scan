{
  "name": "codebase_scan",
  "version": "0.1.0",
  "description": "AI Scan Review",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node src/index.ts",
    "start:docker": "docker compose up --build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/type-provider-zod": "^1.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@npmcli/arborist": "^10.0.3",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "^5.104.2",
    "@typesafe-ai/sdk": "0.6.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ofetch": "^1.5.1",
    "openai": "^7.32.0",
    "p-limit": "^7.3.3",
    "pg": "^8.20.0",
    "pg-boss": "12.37.1",
    "pino": "^10.4.0",
    "react-hook-form": "^7.90.0",
    "semver": "^7.7.4",
    "tailwind-merge": "^3.7.0",
    "tar": "^7.5.11",
    "validate-npm-package-name": "^8.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.55.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "vitest": "5.0.3"
  }
}
